#!/usr/bin/env zsh
# Saca fotogramas PNG de un vídeo de grabar-pantalla para que un agente (que lee imágenes, no
# vídeo) pueda analizarlo. Cuatro modos:
#   fotogramas <video> [N]                      N fotogramas repartidos por todo el vídeo (12 por defecto)
#   fotogramas <video> --hoja [N]               una hoja de contacto: un PNG con N miniaturas y su tiempo
#   fotogramas <video> --tramo <desde> <hasta>  TODOS los fotogramas entre esos segundos (p. ej. 2.0 3.5),
#                                               tal como están en el vídeo: sin remuestrear ni duplicar
#   fotogramas <video> --lento <N>              copia N veces más lenta (N de 2 a 20, admite decimales),
#                                               con TODOS los fotogramas reales y SIN AUDIO; no es PNG
# Opciones: --ancho <px> escala a ese ancho (muestreo y hoja: 1600 por defecto, que es lo que mejor
# leen los agentes; --tramo: tamaño original, porque ahí importa el detalle), --salida <dir> cambia
# la carpeta (por defecto, junto al vídeo: <nombre>-fotogramas/ o <nombre>-tramo-<desde>-<hasta>/),
# --forzar permite un --tramo de más de 300 imágenes. --lento escribe <nombre>-lento-<N>x.mp4 (junto al
# vídeo o en --salida <dir>; si existe, se sobrescribe) sin reencodar: multiplica las marcas de tiempo
# (ffmpeg -itsscale), no inventa ni descarta fotogramas. Imprime la ruta, duración antes y después y
# fotogramas (iguales). El audio se descarta: N veces más lento no se entiende.
# Cada PNG se llama t<milisegundos>ms.png con su tiempo de presentación en el vídeo (t002345ms.png),
# para poder citarlo. Al acabar imprime la carpeta y cuántos PNG; en --tramo, también el intervalo medio
# y máximo entre fotogramas, que es lo que delata saltos. El vídeo no se toca.
# La hoja pone el tiempo sobre cada miniatura con ImageMagick (el ffmpeg de Homebrew no trae drawtext);
# sin ImageMagick o sin una tipografía del sistema sale igual, sin texto.
set -euo pipefail
export PATH=$PATH:/opt/homebrew/bin:/usr/local/bin
# El Mac de David usa coma decimal: awk y printf leerían mal «0.008333».
export LC_ALL=C

fallo() { print -u2 -r -- "fotogramas: $*"; exit 1; }
yo=$0  # dentro de una función, $0 de zsh es el nombre de la función, no el del script
uso() { sed -n '2,21p' "$yo" | sed 's/^# \{0,1\}//' >&2; exit 2; }

modo=muestreo n= desde= hasta= ancho= salida= forzar=0 video= lento=
args=("$@")
i=1
while (( i <= $#args )); do
  a=${args[i]}
  case $a in
    -h|--help) uso ;;
    --hoja) modo=hoja
      if [[ ${args[i+1]:-} == <-> ]]; then n=${args[i+1]}; (( ++i )); fi ;;
    --tramo) modo=tramo
      [[ -n ${args[i+1]:-} && -n ${args[i+2]:-} ]] || fallo "--tramo pide <desde> <hasta> en segundos"
      desde=${args[i+1]} hasta=${args[i+2]}; i=$(( i + 2 )) ;;
    --lento) modo=lento
      lento=${args[i+1]:-}; [[ -n $lento && $lento != -* ]] || fallo "--lento pide N (de 2 a 20, p. ej. 2.5)"
      (( ++i )) ;;
    --ancho) ancho=${args[i+1]:-}; [[ $ancho == <-> ]] || fallo "--ancho pide píxeles"; (( ++i )) ;;
    --salida) salida=${args[i+1]:-}; [[ -n $salida ]] || fallo "--salida pide una carpeta"; (( ++i )) ;;
    --forzar) forzar=1 ;;
    -*) fallo "opción desconocida: $a" ;;
    *) if [[ -z $video ]]; then video=$a
       elif [[ $a == <-> && -z $n ]]; then n=$a
       else fallo "argumento sobrante: $a"; fi ;;
  esac
  (( ++i ))
done
[[ -n $video ]] || uso
[[ -f $video ]] || fallo "no existe $video"
command -v ffmpeg >/dev/null && command -v ffprobe >/dev/null || fallo "falta ffmpeg (brew install ffmpeg)"
if [[ $modo == lento ]]; then
  [[ -z $n ]] || fallo "--lento no admite el argumento $n"
  [[ $lento =~ '^[0-9]+(\.[0-9]+)?$' ]] || fallo "--lento pide un número (de 2 a 20), no «$lento»"
  awk -v x=$lento 'BEGIN {exit !(x >= 2 && x <= 20)}' || fallo "--lento pide N de 2 a 20, no $lento"
fi
[[ -z $n ]] && n=12
(( n >= 1 )) || fallo "N debe ser ≥ 1"
if [[ $modo == tramo ]]; then
  num='^[0-9]+(\.[0-9]+)?$'
  [[ $desde =~ $num && $hasta =~ $num ]] || fallo "desde y hasta son segundos, con decimales si hace falta"
  (( hasta > desde )) || fallo "hasta debe ser mayor que desde"
fi
# Muestreo y hoja: 1600 px por defecto. Tramo: original.
[[ -z $ancho && $modo != tramo ]] && ancho=1600

video=${video:A}
base=${video:t:r}
if [[ -n $salida ]]; then dir=${salida:A}
elif [[ $modo == lento ]]; then dir=${video:h}
elif [[ $modo == tramo ]]; then dir=${video:h}/$base-tramo-$desde-$hasta
else dir=${video:h}/$base-fotogramas; fi
mkdir -p "$dir"
# Repetir el mismo comando no ensucia la carpeta: lo que este script escribió antes (los t<ms>ms.png, o
# la hoja.png en --hoja) es salida regenerable y se vacía al empezar. Otros ficheros no se tocan.
if [[ $modo == lento ]]; then previos=()  # el mp4 se sobrescribe con -y, más abajo
elif [[ $modo == hoja ]]; then previos=($dir/hoja.png(N)); else previos=($dir/t<->ms(|_<->).png(N)); fi
if (( ${#previos} )); then
  rm -f -- $previos
  print -r -- "Aviso: vaciados ${#previos} fichero(s) de una ejecución anterior en $dir"
fi
tmp=$(mktemp -d "${TMPDIR:-/tmp}/fotogramas.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
: > "$tmp/escritos"

dur=$(ffprobe -v error -select_streams v:0 -show_entries format=duration -of csv=p=0 "$video")
[[ $dur == <->* ]] || fallo "ffprobe no lee la duración de $video"
escala=; [[ -n $ancho ]] && escala="scale='min($ancho,iw)':-2:flags=lanczos,"

# Nombre t<ms>ms.png a partir de un tiempo en segundos; si dos caen en el mismo ms, sufijo _2, _3…
nombre() {
  local ms=$(printf '%.0f' $(( $1 * 1000 ))) base_ n_=1 f
  f=$(printf 't%06dms' $ms); base_=$f
  while [[ -e $dir/$f.png ]]; do (( ++n_ )); f=${base_}_$n_; done
  print -r -- $f.png
}

# Mueve los $tmp/f_NNNNNN.png a $dir con el nombre de su pts_time (en el orden de $1, un tiempo por línea).
renombrar() {
  local -a ts files; ts=("${(@f)$(<$1)}"); files=($tmp/f_*.png(N))
  (( ${#ts} == ${#files} )) || fallo "ffmpeg escribió ${#files} PNG y vio ${#ts} fotogramas"
  local k
  local nom
  for k in {1..${#files}}; do
    nom=$(nombre $ts[k]); mv "$files[k]" "$dir/$nom"; print -r -- $nom >> "$tmp/escritos"
  done
}

# Tiempos (pts_time) de los fotogramas que ha pasado ffmpeg, del log de showinfo.
tiempos() { grep -o 'pts_time:[-0-9.e]*' "$1" | cut -d: -f2; }

case $modo in
lento)
  out=$dir/$base-lento-${lento}x.mp4
  [[ $out != $video ]] || fallo "la salida coincidiría con el vídeo de entrada"
  [[ -e $out ]] && print -r -- "Aviso: sobrescrito $out de una ejecución anterior"
  # -itsscale multiplica las marcas de tiempo de entrada: con copy no se toca ningún fotograma ni se
  # reencoda. -an: el audio N veces más lento no sirve.
  ffmpeg -hide_banner -nostats -loglevel error -y -itsscale $lento -i "$video" -map 0:v:0 -c:v copy -an \
    "$out" || fallo "ffmpeg falló"
  cuenta() { ffprobe -v error -count_packets -select_streams v:0 -show_entries stream=nb_read_packets \
    -of csv=p=0 "$1"; }
  duracion() { ffprobe -v error -show_entries format=duration -of csv=p=0 "$1"; }
  f0=$(cuenta "$video") f1=$(cuenta "$out")
  [[ $f0 == $f1 ]] || fallo "la copia tiene $f1 fotogramas y el original $f0"
  print -r -- "Vídeo: $out"
  awk -v a=$(duracion "$video") -v b=$(duracion "$out") -v n=$f1 -v x=$lento \
    'BEGIN {printf "Duración: %.3f s -> %.3f s (x%s); fotogramas: %d (los mismos)\n", a, b, x, n}'
  ;;
tramo)
  # Estimación sin decodificar: paquetes de vídeo con pts en el intervalo.
  est=$(ffprobe -v error -select_streams v:0 -show_entries packet=pts_time -of csv=p=0 "$video" \
    | awk -v a=$desde -v b=$hasta '$1+0>=a && $1+0<=b {c++} END {print c+0}')
  (( est > 0 )) || fallo "no hay fotogramas entre $desde s y $hasta s (el vídeo dura ${dur%%.*}.${${dur#*.}[1,2]} s)"
  if (( est > 300 && ! forzar )); then
    fallo "el tramo tiene $est fotogramas (más de 300); acórtalo o añade --forzar"
  fi
  pre=$(( desde > 1 ? desde - 1 : 0 ))
  # -copyts conserva los tiempos del vídeo tras el -ss; select se queda con el intervalo (ambos extremos
  # incluidos) y passthrough impide que ffmpeg duplique o descarte fotogramas para igualar una tasa.
  ffmpeg -hide_banner -nostats -loglevel info -ss $pre -copyts -i "$video" \
    -vf "select='gte(t,$desde)*lte(t,$hasta)',${escala}showinfo" -fps_mode passthrough \
    "$tmp/f_%06d.png" 2> "$tmp/log" || { tail -5 "$tmp/log" >&2; fallo "ffmpeg falló"; }
  tiempos "$tmp/log" > "$tmp/ts"
  renombrar "$tmp/ts"
  total=$(wc -l < "$tmp/escritos" | tr -d ' ')
  print -r -- "Carpeta: $dir"
  print -r -- "PNG: $total (entre $desde s y $hasta s)"
  sort -g "$tmp/ts" | awk 'NR>1 {d=($1-p)*1000; s+=d; if (d>m) m=d; k++} {p=$1}
    END { if (k) printf "Intervalo entre fotogramas: medio %.1f ms, máximo %.1f ms (%d intervalos)\n", s/k, m, k
          else print "Un solo fotograma: no hay intervalos" }'
  ;;
muestreo|hoja)
  # N instantes en el centro de N tramos iguales; para cada uno, el primer fotograma desde ese instante.
  out=$dir; [[ $modo == hoja ]] && out=$tmp/m && mkdir -p "$out"
  real=$dir; dir=$out
  : > "$tmp/ts_all"
  for k in {0..$(( n - 1 ))}; do
    t=$(awk -v d=$dur -v k=$k -v n=$n 'BEGIN {printf "%.6f", d*(k+0.5)/n}')
    ffmpeg -hide_banner -nostats -loglevel info -ss $t -copyts -i "$video" \
      -vf "${escala}showinfo" -fps_mode passthrough -frames:v 1 "$tmp/f_000001.png" -y 2> "$tmp/log" \
      || { tail -5 "$tmp/log" >&2; fallo "ffmpeg falló en t=$t"; }
    [[ -f $tmp/f_000001.png ]] || continue
    tiempos "$tmp/log" | head -1 > "$tmp/ts"
    renombrar "$tmp/ts"
    cat "$tmp/ts" >> "$tmp/ts_all"
  done
  dir=$real
  if [[ $modo == muestreo ]]; then
    print -r -- "Carpeta: $dir"
    print -r -- "PNG: $(wc -l < "$tmp/escritos" | tr -d ' ') (repartidos por ${dur%%.*} s de vídeo)"
  else
    cols=$(awk -v n=$n 'BEGIN {c=int(sqrt(n)+0.999); print c}')
    hoja=$dir/hoja.png
    font=
    for f in /System/Library/Fonts/Helvetica.ttc /System/Library/Fonts/Supplemental/Arial.ttf \
             /usr/share/fonts/**/DejaVuSans.ttf(N[1]); do [[ -f $f ]] && { font=$f; break; }; done
    # Con ImageMagick y una tipografía, el tiempo va sobre cada miniatura; si no, tile de ffmpeg sin texto.
    if command -v magick >/dev/null && [[ -n $font ]]; then
      miniatura=$(( ancho / cols ))
      # Etiqueta «t=SS.mmm s» a partir del nombre en ms.
      labels=()
      for p in $tmp/m/t*ms.png(n); do
        [[ ${p:t} =~ '^t([0-9]+)ms' ]]; ms=$(( 10#$match[1] ))
        labels+=(-label "$(printf '%d.%03d s' $(( ms / 1000 )) $(( ms % 1000 )))" "$p")
      done
      magick montage -font "$font" -pointsize $(( miniatura / 14 + 8 )) -fill white -background '#222' \
        -geometry ${miniatura}x+4+4 -tile ${cols}x "${labels[@]}" "$hoja"
      print -r -- "Tiempos sobre las miniaturas: sí (ImageMagick)"
    else
      miniatura=$(( ancho / cols ))
      # Enlaces s_001.png… en orden numérico del tiempo (el glob de ffmpeg ordenaría «t1501…» antes que «t501…»).
      k=0; for p in $tmp/m/t*ms.png(n); do (( ++k )); ln -s "$p" "$tmp/s_${(l:3::0:)k}.png"; done
      ffmpeg -hide_banner -nostats -loglevel error -y -framerate 1 -i "$tmp/s_%03d.png" \
        -vf "scale=${miniatura}:-2,tile=${cols}x$(( (n + cols - 1) / cols )):padding=4" -frames:v 1 "$hoja"
      print -r -- "Tiempos sobre las miniaturas: no (sin ImageMagick ni tipografía); ver la lista:"
      for p in $tmp/m/t*ms.png(n); do print -r -- "  ${p:t}"; done
    fi
    print -r -- "Carpeta: $dir"
    print -r -- "Hoja: $hoja ($n miniaturas, $cols columnas, ancho ${ancho}px)"
  fi
  ;;
esac
